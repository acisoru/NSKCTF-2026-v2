{
  "name": "lab-x-quarantine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=../deploy/.env server/index.mjs",
    "dev": "npm run build && node --env-file-if-exists=../deploy/.env server/index.mjs",
