    "test:load": "node tests/load.mjs"
  },
  "dependencies": {
    "cannon-es": "0.20.0",
    "lucide": "^0.577.0",
    "three": "^0.183.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "playwright": "^1.58.2"
  }
}
